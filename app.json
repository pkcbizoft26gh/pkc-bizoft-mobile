{
  "expo": {
    "name": "PKC BIZOFT",
    "slug": "pkc-bizoft-mobile",
    "version": "0.8.6",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "pkcbizoft",
    "icon": "./assets/images/icon.png",
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "defaultChannel": "pkc-alerts"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050B14",
          "image": "./assets/images/pkc-transparent.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      "expo-sharing"
    ],
    "android": {
      "package": "com.pkcbizoft.mobile",
      "googleServicesFile": "./google-services.json",
      "versionCode": 82,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#050B14"
      }
    },
    "ios": {
      "bundleIdentifier": "com.pkcbizoft.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "gcash"
        ]
      }
    },
    "web": {
      "bundler": "metro"
    }
  }
}
